# Target profile only: no server or database connection is made by this file.
# Copy VALUES into the selected Hostinger service's private environment settings.
NODE_ENV=production
DEPLOYMENT_TARGET=hostinger
# The complete MySQL adapter is still pending. This choice intentionally fails closed.
DATA_PROVIDER=mysql
ALLOW_LOCAL_DEMO=false
NEXT_PUBLIC_SITE_URL=
ENABLE_INDEXING=false
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL_CA_FILE=
MYSQL_POOL_LIMIT=5
# Absolute persistent directory OUTSIDE public_html / public / release directories.
# Use the actual path provided by the selected Hostinger plan or VPS.
PRIVATE_STORAGE_ROOT=
# VPS behind a reverse proxy: 127.0.0.1. Managed Node service: use its required bind host.
HOSTINGER_BIND_HOST=127.0.0.1
PORT=3000
LOCAL_SESSION_SECRET=
CRON_SECRET=
# Hostinger/Titan/other mailbox host depends on the actual purchased email service.
# Read SMTP values from its panel. Do not assume that email is included in hosting.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# The admin Email designs panel can set the sales/reply address instead.
ORDER_EMAIL_FROM=
ORDER_EMAIL_REPLY_TO=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
IYZICO_TEST_API_KEY=
IYZICO_TEST_SECRET_KEY=
IYZICO_LIVE_API_KEY=
IYZICO_LIVE_SECRET_KEY=
