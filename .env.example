# Server data provider: auto (existing behavior), sqlite-demo, supabase, mysql.
# mysql is reserved for the next integration stage and fails closed today.
# No production connection is made or inferred from this file.
DATA_PROVIDER=auto
# Future Hostinger MySQL adapter settings. NEVER prefix these with NEXT_PUBLIC.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Certificate verification must stay enabled for remote TLS connections.
MYSQL_SSL_CA_FILE=
MYSQL_POOL_LIMIT=10
# Leave Supabase unset to use the explicitly labeled local demonstration database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Customer signup/login are disabled. Guest checkout uses private server RPCs (migration 017).
# Optional canonical origin. Set to your verified production domain before deployment.
NEXT_PUBLIC_SITE_URL=
# Enable indexing only after real products and legal pages are reviewed.
ENABLE_INDEXING=false
# Local development only. Run npm run setup:demo to generate private values.
LOCAL_ADMIN_PASSWORD=
# Windows setup stores a password hash instead of a plaintext password.
LOCAL_ADMIN_PASSWORD_HASH=
LOCAL_SESSION_SECRET=
# Payments remain disabled until enabled in the authenticated admin.
# Server-only key for payment RPCs and private request/CRM data/files (migrations 008–009).
# NEVER use a NEXT_PUBLIC prefix. Guest request writes are validated by server routes.
SUPABASE_SERVICE_ROLE_KEY=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
IYZICO_TEST_API_KEY=
IYZICO_TEST_SECRET_KEY=
IYZICO_LIVE_API_KEY=
IYZICO_LIVE_SECRET_KEY=
# Optional scheduled stock-reservation expiry endpoint bearer secret.
CRON_SECRET=

# Optional release label for grouping analytics heatmaps after design releases.
# Use only letters, numbers, underscores and hyphens (max. 64).
NEXT_PUBLIC_ANALYTICS_REVISION=site

# Transactional order/shipment email: disabled until a verified sender and server key exist.
# No real email is sent from sqlite-demo or the browser workspace.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_REPLY_TO=
# Schedule authenticated GET /api/notifications/dispatch every minute using CRON_SECRET.
